GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
CONTACT_RECEIVER_EMAIL=sales@Clickmasterssoftwaredevelopmentcompany.com

# ERP / headless CMS (public read-only API). Leave CMS_API_URL empty to disable.
CMS_API_URL=https://apierp.clickmasters.pk
CMS_SITE_DOMAIN=clickmasterssoftwaredevelopmentcompany.com
# Live updates: seconds between ERP checks while a tab is visible (0 = only on tab focus/navigation).
NEXT_PUBLIC_CMS_LIVE_POLL_SECONDS=3
# Run customCode.js from ERP pages (off unless explicitly "true").
CMS_ALLOW_CUSTOM_JS=false
# Use the ERP's brand colours on created pages instead of the site theme (off by default).
CMS_USE_ERP_COLORS=false
